# 复制本文件为 .env，在此填写硅基流动密钥。不要上传或发送真实密钥。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 可根据账户中实际可用的模型修改，模型服务可能调整。
SF_MODEL_WRITER=deepseek-ai/DeepSeek-V4.1-Flash
SF_MODEL_DIRECTOR=zai-org/GLM-5.3-Flash
SF_MODEL_DIRECTOR_PRO=zai-org/GLM-5.3
SF_MODEL_ANIMATION=moonshotai/Kimi-K2.7-Code
SF_MODEL_REVIEWER=zai-org/GLM-5.3-Flash
SF_MODEL_IMAGE=OpenMOSS-Team/MOSS-Image
SF_MODEL_IMAGE_FAST=Tongyi-MAI/Z-Image-Turbo
SF_MODEL_VIDEO=MiniMaxAI/MiniMax-H3
SF_MODEL_SPEECH=FunAudioLLM/CosyVoice2-0.5B
SF_MODEL_SPEECH_ALT=fnlp/MOSS-TTSD-v0.5
# 用户按平台实时价格自行填写；留空则不会自动生成对应图片/视频。
SF_PRICE_IMAGE_CNY=
SF_PRICE_VIDEO_SECOND_CNY=
# 可选：继续使用原有 OpenAI 兼容的单模型配置；不适用于硅基流动语音/媒体。
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=
# Windows / macOS 本地缺少中文字体时可填写字体路径；Docker 已包含中文字体。
# VIBELAB_FONT=
